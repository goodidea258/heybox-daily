FROM runner AS allinone

USER root
WORKDIR /web

# 兼容 Debian/Alpine 安装运行与定时调度所需的最小依赖
RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends bash openssl curl && rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache bash openssl curl; \
    fi

# 复制完整工作区以匹配 pnpm-lock.yaml，/app 下官方编译好的 Runner 环境不受影响
COPY . .

# 安装指定版本 pnpm 并构建前端产物
RUN (command -v pnpm >/dev/null 2>&1 || npm install -g pnpm@12.15.0) \
    && pnpm install --frozen-lockfile \
    && pnpm --filter @heybox/web build

COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 3000
VOLUME ["/data"]

ENTRYPOINT ["/entrypoint.sh"]
